# 复制这个文件为 .env，然后填上你自己的 key
OPENAI_API_KEY=sk-xxxxxxxx

# 可选：用兼容 OpenAI 协议的端点（DeepSeek、月之暗面、本地 Ollama 等）
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# 可选：改模型
# MODEL=gpt-4o-mini

# ── 护栏与压缩（都有默认值，按需覆盖）──────────────
# 模型上下文窗口大小（token）
# CONTEXT_WINDOW=128000
# 留给模型回复的余量；超过「窗口 - 余量」就触发总结式压缩
# RESERVE_TOKENS=16384
# 压缩时保留最近多少 token 不总结
# KEEP_RECENT_TOKENS=20000
# 压缩触发线（绝对 token 数）。设了它就用它，否则用「窗口 − 余量」。
# 想更早压缩、更省 token，就调小，例如 40000
# COMPACT_TRIGGER_TOKENS=0

# ── 自动重试（临时性错误）──────────────────────
# 开关
# RETRY_ENABLED=true
# 最多重试几次
# RETRY_MAX=3
# 基础延迟（毫秒），按 2 的次幂递增
# RETRY_BASE_DELAY_MS=2000
# 单次延迟上限（毫秒）
# RETRY_MAX_DELAY_MS=60000

# ── 流式输出 ────────────────────────────────
# 开关（某些端点不支持 stream_options，遇 400 可设 false）
# STREAM=true

# ── 权限门（危险操作确认）────────────────────
# 默认 off（不打扰）。想开就选：execute（只拦命令）/ mutate（只拦改文件）/ all
# 开启后会弹确认（回复 a = 本次会话总是允许）
# APPROVAL_MODE=off

# ── 会话存储 ─────────────────────────────────────
# 存储后端：jsonl（默认，可 grep/重放）或 sqlite（node:sqlite，可跨会话查询）
# SESSION_STORE=jsonl
# 会话标识（换一个就是一个新会话）
# SESSION_ID=default
# 存储目录
# SESSION_DIR=.my-agent/sessions

# ── 成本核算（不填则只显示 token，不显示金额）────
# 每百万 token 的价格（美元）
# PRICE_INPUT_PER_MTOK=0
# PRICE_OUTPUT_PER_MTOK=0
# 命中缓存的那部分输入 token 的单价（通常更便宜，不填则同输入价）
# PRICE_CACHED_INPUT_PER_MTOK=0

# ── 长期记忆 ────────────────────────────────────
# 记忆库目录（人可读的 JSON 文件）
# MEMORY_DIR=.my-agent/memory
# 注入系统提示词的记忆 token 上限
# MEMORY_BUDGET_TOKENS=1500
